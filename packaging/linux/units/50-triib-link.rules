// Lets the person at the computer start, stop and restart triib's link
// units, as triib-endpointd runs them: one keeps EEE and PAUSE off and
// one transmit queue, the other restarts an interface whose driver keeps
// its PTP time stamps.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        !subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb");
    if (/^triib-(link|link-reset)@[A-Za-z0-9_.-]+\.service$/.test(unit) &&
        (verb === "start" || verb === "stop" || verb === "restart")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
