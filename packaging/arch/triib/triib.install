# Lets triib, triib-cli and triib-endpointd send and receive raw Ethernet
# without root, through triib-netraw, the one program granted CAP_NET_RAW,
# and has systemd read triib's units, which triib-endpointd
# starts as host entities need them, then says when no interface can
# carry host entities.
grant() {
    setcap cap_net_raw+ep usr/lib/triib/triib-netraw
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
    fi
    usr/lib/triib/endpoint-check || true
}

post_install() {
    grant
}

post_upgrade() {
    grant
}
